# Copier ce fichier en `.env.local` et le compléter. Ne jamais publier `.env.local`.
# Sur Vercel, ces variables se renseignent dans Settings → Environment Variables.

# Adresse publique du site (sert aux balises SEO). Ex. https://www.passingshot.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

